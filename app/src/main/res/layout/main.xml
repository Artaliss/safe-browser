<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:hint="ค้นหาด้วย Google หรือพิมพ์ URL"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
            <Button
                android:id="@+id/tabs"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="แท็บทั้งหมด"
                android:text="1" />
            <Button
                android:id="@+id/menu"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="เมนู"
                android:text="⋮"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/findbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <EditText
                android:id="@+id/findtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="ค้นหาในหน้านี้"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />
            <TextView
                android:id="@+id/findcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp" />
            <Button
                android:id="@+id/findprev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:contentDescription="ก่อนหน้า"
                android:text="▲" />
            <Button
                android:id="@+id/findnext"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:contentDescription="ถัดไป"
                android:text="▼" />
            <Button
                android:id="@+id/findclose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:contentDescription="ปิดการค้นหา"
                android:text="✕" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/pull"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/groupbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/groupbaropen"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="ดูแท็บในกลุ่ม"
                android:minWidth="0dp"
                android:text="⌃"
                android:textSize="20sp" />
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/groupstrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <Button
                android:id="@+id/groupbarnew"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="แท็บใหม่ในกลุ่ม"
                android:minWidth="0dp"
                android:text="＋"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">
            <TextView
                android:id="@+id/switchertitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:textSize="18sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/groupselected"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="จัดกลุ่ม"
                android:visibility="gone" />
            <Button
                android:id="@+id/newtab"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="แท็บใหม่"
                android:text="＋"
                android:textSize="24sp" />
            <Button
                android:id="@+id/switchermenu"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="เมนูแท็บ"
                android:text="⋮"
                android:textSize="22sp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabgrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="6dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/groupoverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/groupsheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:clickable="true"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">
                <View
                    android:id="@+id/groupdot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="12dp"
                    android:contentDescription="สีของกลุ่ม" />
                <EditText
                    android:id="@+id/groupname"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/groupnew"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="แท็บใหม่ในกลุ่ม"
                    android:minWidth="0dp"
                    android:text="＋"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/groupmenu"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="เมนูกลุ่ม"
                    android:minWidth="0dp"
                    android:text="⋮"
                    android:textSize="22sp" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/groupgrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="6dp" />
                <TextView
                    android:id="@+id/removezone"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom"
                    android:background="#E01A73E8"
                    android:gravity="center"
                    android:text="ลากมาตรงนี้เพื่อเอาออกจากกลุ่ม"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:hint="ค้นหาด้วย Google หรือพิมพ์ URL"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
            <Button
                android:id="@+id/tabs"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="แท็บทั้งหมด"
                android:text="1" />
            <Button
                android:id="@+id/menu"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="เมนู"
                android:text="⋮"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/findbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <EditText
                android:id="@+id/findtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="ค้นหาในหน้านี้"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />
            <TextView
                android:id="@+id/findcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp" />
            <Button
                android:id="@+id/findprev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:contentDescription="ก่อนหน้า"
                android:text="▲" />
            <Button
                android:id="@+id/findnext"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:contentDescription="ถัดไป"
                android:text="▼" />
            <Button
                android:id="@+id/findclose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:contentDescription="ปิดการค้นหา"
                android:text="✕" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100" />

        <FrameLayout
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">
            <TextView
                android:id="@+id/switchertitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:textSize="18sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/closeall"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="ปิดทั้งหมด" />
            <Button
                android:id="@+id/newtab"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:contentDescription="แท็บใหม่"
                android:text="＋"
                android:textSize="24sp" />
        </LinearLayout>
        <GridView
            android:id="@+id/tabgrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:horizontalSpacing="12dp"
            android:numColumns="2"
            android:padding="12dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
